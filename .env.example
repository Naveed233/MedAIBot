# Copy to .env and fill in. .env is git-ignored.
OPENAI_API_KEY=
MEDAIBOT_LLM_PROVIDER=openai
MEDAIBOT_LLM_MODEL=gpt-5.4-mini
MEDAIBOT_EMBEDDING_BACKEND=fastembed
MEDAIBOT_LOG_JSON=true
# Hosted demo only: a shared code for /ask, and usage limits (0 turns a limit off).
MEDAIBOT_ACCESS_CODE=
MEDAIBOT_RATE_LIMIT_PER_MINUTE=10
MEDAIBOT_DAILY_QUESTION_CAP=200
